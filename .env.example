# Required ---------------------------------------------------------
# Alchemy: Ethereum mainnet app key (https://dashboard.alchemy.com)
ALCHEMY_API_KEY=

# OpenSea API key (https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY=

# Pinata: scoped JWT with pinFileToIPFS + pinJSONToIPFS permissions
# (https://app.pinata.cloud → API Keys → New Key → copy the JWT, not the key/secret pair)
PINATA_JWT=

# Pinata dedicated gateway subdomain (no protocol, no path). Find it in the Pinata
# dashboard under Gateways. If you don't have a dedicated gateway, you can set this
# to "gateway.pinata.cloud" but expect rate limits.
PINATA_GATEWAY=

# Optional ---------------------------------------------------------
# If unset, lib/etherscan.js falls back to keyless Sourcify ABI lookups.
# ETHERSCAN_API_KEY=
